{
  "name": "ds-cookie-consent",
  "version": "1.0.1",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "build": "node tools/build.mjs",
    "watch": "node tools/build.mjs --watch",
    "size": "node tools/check-size.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "test:php": "composer test:unit",
    "test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/ds_cookie_consent vendor/bin/phpunit -c phpunit-integration.xml.dist",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.js",
    "lint:php": "vendor/bin/phpcs",
    "lint:php74": "sh tools/lint-php74.sh",
    "i18n": "sh tools/i18n/make-languages.sh",
    "release:zip": "bash tools/release/build-zip.sh",
    "check:deep-scan-image": "bash tools/release/check-deep-scan-image.sh",
    "check:zip-activation": "bash tools/release/check-zip-activation.sh test-results/ds-cookie-consent.zip",
    "lint:workflows": "bash tools/release/lint-workflows.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@wordpress/env": "^10.0.0",
    "esbuild": "^0.25.0"
  }
}
